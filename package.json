{
  "name": "despecto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env scripts/serve.ts",
    "dev": "npm start",
    "build": "next build",
    "start:production": "node --experimental-strip-types --env-file-if-exists=.env scripts/serve.ts --production",
    "typecheck": "tsc --noEmit",
    "check:providers": "node --experimental-strip-types --env-file-if-exists=.env scripts/check-providers.ts",
    "evaluate": "node --experimental-strip-types eval/run.ts"
  },
  "dependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "mdast-util-from-markdown": "2.1.0",
    "next": "^16.4.6",
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
